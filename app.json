{
  "expo": {
    "name": "Mr Center",
    "slug": "mr-center",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mrcenter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#060A12",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060A12",
      "imageWidth": 180
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mrcenter.app"
    },
    "android": {
      "package": "com.mrcenter.app",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#060A12"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "الكاميرا مطلوبة لمسح باركود حضور الطلاب من تطبيقاتهم",
          "recordAudioPermission": false
        }
      ]
    ],
    "extra": {
      "configUrl": "https://mr-center-config.mobileshop2026.workers.dev/config",
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    }
  }
}
